{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/satyam/trading/agent-contract/schema.json",
  "title": "Agent Contract schemas",
  "description": "Machine-validatable shapes for the Strategy Contract (v0.1 DRAFT). Enumerations are generated from trading.paper.enums and pinned by tests/agent_contract/test_contract_bundle.py, so a value accepted here is a value the order API accepts.",
  "$defs": {
    "InstrumentRef": {
      "type": "object",
      "required": [
        "exchange",
        "segment",
        "symbol"
      ],
      "additionalProperties": false,
      "properties": {
        "exchange": {
          "type": "string",
          "examples": [
            "NSE",
            "BSE",
            "BINANCE"
          ]
        },
        "segment": {
          "type": "string",
          "examples": [
            "CM",
            "FO",
            "SPOT"
          ]
        },
        "symbol": {
          "type": "string",
          "examples": [
            "RELIANCE",
            "BTC-USDT"
          ]
        }
      }
    },
    "Query": {
      "type": "object",
      "additionalProperties": false,
      "description": "A universe resolved point-in-time against listed_on/delisted_on at ctx.now, so a backtest sees the instruments that existed then, including ones since delisted. This is the survivorship-bias guarantee.",
      "properties": {
        "asset_class": {
          "type": "string",
          "enum": [
            "EQUITY",
            "FUTURE",
            "OPTION",
            "CRYPTO",
            "MF"
          ]
        },
        "exchange": {
          "type": "string"
        },
        "index": {
          "type": "string",
          "examples": [
            "NIFTY50"
          ]
        }
      }
    },
    "Param": {
      "type": "object",
      "required": [
        "type",
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "int",
            "float",
            "decimal",
            "str",
            "bool"
          ]
        },
        "default": {},
        "bounds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "DataRequest": {
      "type": "object",
      "required": [
        "bars"
      ],
      "additionalProperties": false,
      "properties": {
        "bars": {
          "type": "string",
          "enum": [
            "1m",
            "5m",
            "15m",
            "1h",
            "1d"
          ],
          "description": "The intervals the platform stores. Anything else has no data behind it."
        },
        "ticks": {
          "type": "boolean",
          "default": false
        },
        "history_bars": {
          "type": "integer",
          "minimum": 0,
          "default": 100
        }
      }
    },
    "StrategyManifest": {
      "type": "object",
      "required": [
        "name",
        "version",
        "universe",
        "data",
        "capital",
        "base_currency"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "universe": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/InstrumentRef"
              }
            },
            {
              "$ref": "#/$defs/Query"
            }
          ]
        },
        "data": {
          "$ref": "#/$defs/DataRequest"
        },
        "capital": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "base_currency": {
          "type": "string",
          "description": "A portfolio holds ONE currency and performs no FX conversion.",
          "examples": [
            "INR",
            "USDT"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Param"
          }
        },
        "max_daily_loss": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "max_drawdown_pct": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "leverage": {
          "type": [
            "string",
            "null"
          ],
          "description": "Required for a perpetual, forbidden otherwise. A decimal number as a STRING. Declared once for the strategy, never per order: it decides how much margin each position locks up. Absent means this strategy trades nothing levered -- which is not the same as 1.",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        }
      }
    },
    "Instrument": {
      "type": "object",
      "required": [
        "instrument_id",
        "asset_class",
        "exchange",
        "segment",
        "symbol",
        "currency",
        "status"
      ],
      "properties": {
        "instrument_id": {
          "type": "integer"
        },
        "asset_class": {
          "type": "string",
          "enum": [
            "EQUITY",
            "FUTURE",
            "OPTION",
            "CRYPTO",
            "MF"
          ]
        },
        "exchange": {
          "type": "string"
        },
        "segment": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "underlying_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "expiry": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "strike": {
          "oneOf": [
            {
              "type": "string",
              "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "option_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "CE",
            "PE",
            null
          ]
        },
        "tick_size": {
          "oneOf": [
            {
              "type": "string",
              "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "isin": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "listed_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "delisted_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "Bar": {
      "type": "object",
      "required": [
        "instrument_id",
        "ts",
        "interval_sec",
        "open",
        "high",
        "low",
        "close"
      ],
      "properties": {
        "instrument_id": {
          "type": "integer"
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "description": "UTC, timezone-aware. Marks the START of the interval."
        },
        "interval_sec": {
          "type": "integer",
          "enum": [
            60,
            300,
            900,
            3600,
            86400
          ]
        },
        "open": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "high": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "low": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "close": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "volume": {
          "oneOf": [
            {
              "type": "string",
              "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "trades": {
          "type": [
            "integer",
            "null"
          ]
        },
        "open_interest": {
          "type": [
            "integer",
            "null"
          ]
        },
        "oi_change": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "Tick": {
      "type": "object",
      "required": [
        "instrument_id",
        "ts",
        "price",
        "quantity"
      ],
      "properties": {
        "instrument_id": {
          "type": "integer"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "price": {
          "type": "string",
          "description": "Strictly positive.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "quantity": {
          "type": "string",
          "description": "May be zero -- an index tick has no traded size.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "side": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Order": {
      "type": "object",
      "required": [
        "order_id",
        "instrument_id",
        "side",
        "order_type",
        "quantity",
        "filled_quantity",
        "product",
        "time_in_force",
        "status",
        "rationale"
      ],
      "properties": {
        "order_id": {
          "type": "integer"
        },
        "instrument_id": {
          "type": "integer"
        },
        "side": {
          "type": "string",
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "order_type": {
          "type": "string",
          "enum": [
            "MARKET",
            "LIMIT"
          ]
        },
        "quantity": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "filled_quantity": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "limit_price": {
          "oneOf": [
            {
              "type": "string",
              "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "product": {
          "type": "string",
          "enum": [
            "DELIVERY",
            "INTRADAY"
          ]
        },
        "time_in_force": {
          "type": "string",
          "enum": [
            "DAY",
            "GTC"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "OPEN",
            "PARTIALLY_FILLED",
            "FILLED",
            "CANCELLED",
            "REJECTED",
            "EXPIRED"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Required and non-empty. Every order records why it was placed."
        },
        "rejection_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Set when status is REJECTED; names exactly what was wrong."
        }
      }
    },
    "Position": {
      "type": "object",
      "required": [
        "instrument_id",
        "quantity",
        "avg_cost",
        "realised_pnl"
      ],
      "properties": {
        "instrument_id": {
          "type": "integer"
        },
        "quantity": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "avg_cost": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "realised_pnl": {
          "type": "string",
          "description": "A decimal number as a STRING, never a JSON number -- binary floating point has no place in this platform's money path.",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        }
      }
    }
  }
}
